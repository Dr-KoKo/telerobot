  - key: haetae.specialization.melee.description
    value: "\uADFC\uC811 \uB3CC\uC785\uACFC \uB2E4\uC911 \uD0C0\uACA9\uC5D0 \uD2B9\uD654.
      \uC804\uD22C \uBC30\uD130\uB9AC \uC18C\uBAA8\uAC00 \uC99D\uAC00\uD569\uB2C8\uB2E4."
  - key: haetae.specialization.ranged.description
    value: "\uC548\uC804 \uAC70\uB9AC\uB97C \uC720\uC9C0\uD558\uBA70 \uC0AC\uACA9.
      \uBC1B\uB294 \uD53C\uD574\uAC00 \uC99D\uAC00\uD569\uB2C8\uB2E4."
  - key: haetae.specialization.balanced.description
    value: "\uC811\uADFC \uC911 \uC0AC\uACA9\uD558\uACE0 \uADFC\uAC70\uB9AC\uC5D0\uC11C\uB294
      \uBB3C\uC5B4\uB72F\uAE30\uB85C \uC804\uD658\uD569\uB2C8\uB2E4."
  - key: haetae.specialization.panel_title
    value: "\uD574\uD0DC \uC804\uBB38\uD654"
