  - key: haetae.mastery.efficiency
    value: "\uB3D9\uB825 \uD6A8\uC728"
  - key: haetae.mastery.efficiency.description
    value: "\uC804\uD22C \uC911 \uBC30\uD130\uB9AC \uC18C\uBAA8\uAC00 \uB4F1\uAE09\uB2F9
