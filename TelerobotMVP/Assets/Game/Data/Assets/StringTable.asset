  - key: haetae.mastery.power.description
    value: "\uBAA8\uB4E0 \uACF5\uACA9 \uD53C\uD574\uAC00 \uB4F1\uAE09\uB2F9 10% \uC99D\uAC00\uD569\uB2C8\uB2E4."
  - key: haetae.mastery.armor
    value: "\uC7A5\uAC11 \uAC15\uD654"
  - key: haetae.mastery.armor.description
    value: "\uBC1B\uB294 \uD53C\uD574\uAC00 \uB4F1\uAE09\uB2F9 8% \uAC10\uC18C\uD569\uB2C8\uB2E4.
