  entries:
  - key: radio.game_start
    value: "\uD154\uB808 \uB85C\uBD07\uD300, \uCD9C\uACA9\uD558\uB77C."
  - key: radio.phase1
    value: "\uAC10\uC5FC\uCCB4 \uC811\uADFC. \uBD81\uCABD \uB3C4\uB85C \uBC29\uC5B4
      \uC900\uBE44."
  - key: radio.phase2
    value: "\uB3D9\uCABD \uACE8\uBAA9\uC5D0\uC11C \uCD94\uAC00 \uC811\uADFC \uC2E0\uD638
      \uAC10\uC9C0."
  - key: radio.phase3
    value: "\uB0A8\uCABD \uD130\uB110 \uAC1C\uBC29. \uBA54\uB514\uCEEC \uB85C\uBD07
      \uD22C\uC785."
  - key: radio.phase4
    value: "\uD6C4\uBC18 \uACF5\uC138 \uAC1C\uC2DC. \uC138 \uACBD\uB85C\uB97C \uC0AC\uC218\uD558\uB77C."
  - key: radio.phase5
    value: "\uB3D9\uCABD \uACE8\uBAA9\uC758 \uC801 \uBC00\uB3C4\uAC00 \uC99D\uAC00\uD55C\uB2E4."
  - key: radio.phase6
    value: "\uBD81\uCABD \uB3C4\uB85C\uC5D0 \uC911\uC7A5 \uAC10\uC5FC\uCCB4\uAC00
      \uC9D1\uACB0\uD55C\uB2E4."
  - key: radio.phase7
    value: "\uB0A8\uCABD \uD130\uB110 \uC555\uBC15\uC774 \uAC70\uC138\uC9C4\uB2E4."
  - key: radio.phase8
    value: "\uCD5C\uC885 \uACF5\uC138\uB2E4. \uAC70\uC810\uC744 \uB05D\uAE4C\uC9C0
      \uC0AC\uC218\uD558\uB77C."
  - key: radio.battery_warning
    value: "\uD574\uD0DC 1\uD638, \uBC30\uD130\uB9AC \uC704\uD5D8."
  - key: radio.base_danger
    value: "\uAC70\uC810 \uBC29\uC5B4\uC120 \uBD95\uAD34 \uC784\uBC15."
  - key: radio.phase_clear
    value: "\uC704\uD611 \uC81C\uAC70. \uC7AC\uC815\uBE44 \uB2E8\uACC4 \uC9C4\uC785."
  - key: radio.victory
    value: "\uAC70\uC810 \uC0DD\uC874 \uD655\uC778. \uC791\uC804 \uC131\uACF5."
